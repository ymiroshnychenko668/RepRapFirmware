# Octopus V1.1 F446 / Reborn 2, native USB and UART, 32 KiB BTT loader.
ifneq ($(NETWORK),NONE)
$(error Octopus F446 requires NETWORK=NONE; networking runs on the SBC)
endif
MCU_FLAGS = -DSTM32F446xx -DSTM32F446 -DSTM32F446_5ZX
CORE_CAN_FLAGS = -DSUPPORT_CAN=0 -DUSE_SPICAN=0
CORE_VARIANT_DIR = $(REPRAPFIRMWARE_DIR)/src/Hardware/STM32/variants/STM32F446
CORE_STARTUP = $(CORE_VARIANT_DIR)/startup_stm32f446xx.S
LINKER_SCRIPT_BASE = $(CORE_VARIANT_DIR)/ldscript
VECT_TAB_OFFSET = 0x8000
PRINTER_FLAGS += -DOCTOPUS_F446 -DRRF_NETWORK_NONE
TMC22XX = true
TMC51XX = false
LD_FLASH_BYTES = 524288
LD_RAM_BYTES = 131072
